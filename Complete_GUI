class SplashScreen(tk.Toplevel):
    DURATION_MS = 3200
    BAR_STEPS   = 100

    def __init__(self, master):
        super().__init__(master)
        self.overrideredirect(True)
        self.configure(bg=C["splash_bg"])
        self.attributes("-topmost", True)

        w, h = 520, 340
        sw = self.winfo_screenwidth()
        sh = self.winfo_screenheight()
        self.geometry(f"{w}x{h}+{(sw-w)//2}+{(sh-h)//2}")

        self._build_ui(w, h)
        self._start_progress()

    def _build_ui(self, w, h):
        self.canvas = tk.Canvas(self, width=w, height=h,
                                bg=C["splash_bg"], highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)
        self._draw_logo(w, h)

        self.canvas.create_text(w // 2, 200, text="QNEST",
            font=("DM Sans", 36, "bold"), fill=C["accent"])
        self.canvas.create_text(w // 2, 238,
            text="Qauntum Network End-to-end Simulation Toolkit",
            font=("DM Sans", 12), fill="#8899AA")

        bar_x, bar_y, bar_w, bar_h = 80, 288, w - 160, 7
        self.canvas.create_rectangle(bar_x, bar_y, bar_x + bar_w, bar_y + bar_h,
            fill="#1E2535", outline="#2A3347")
        self._bar_x   = bar_x
        self._bar_y   = bar_y
        self._bar_w   = bar_w
        self._bar_h   = bar_h
        self._bar_fill = self.canvas.create_rectangle(
            bar_x, bar_y, bar_x, bar_y + bar_h, fill=C["accent"], outline="")
        self._status_id = self.canvas.create_text(w // 2, 310,
            text="Initialising…", font=("DM Sans", 10), fill="#8899AA")

    def _draw_logo(self, w, h):
        cx, cy, r = w // 2, 115, 48
        self.canvas.create_oval(cx-r, cy-r, cx+r, cy+r, outline=C["accent"], width=2)
        ir = r * 0.55
        self.canvas.create_oval(cx-ir, cy-ir, cx+ir, cy+ir, outline="#534AB7", width=1)
        dot_r = 5
        for deg in (90, 210, 330):
            rad = math.radians(deg)
            dx  = cx + r * math.cos(rad)
            dy  = cy - r * math.sin(rad)
            self.canvas.create_oval(dx-dot_r, dy-dot_r, dx+dot_r, dy+dot_r,
                fill=C["accent"], outline="")
            self.canvas.create_line(cx, cy, dx, dy, fill="#2A3347", width=1)
        self.canvas.create_oval(cx-6, cy-6, cx+6, cy+6, fill="#534AB7", outline="")

    _MESSAGES = [
        "Loading circuit engine…",
        "Initialising network layer…",
        "Preparing compiler…",
        "Building scheduler…",
        "Almost ready…",
    ]

    def _start_progress(self):
        self._step = 0
        self._tick()

    def _tick(self):
        if self._step > self.BAR_STEPS:
            self._finish()
            return
        pct    = self._step / self.BAR_STEPS
        fill_w = int(self._bar_w * pct)
        self.canvas.coords(self._bar_fill,
            self._bar_x, self._bar_y,
            self._bar_x + fill_w, self._bar_y + self._bar_h)
        msg_idx = min(int(pct * len(self._MESSAGES)), len(self._MESSAGES) - 1)
        self.canvas.itemconfig(self._status_id, text=self._MESSAGES[msg_idx])
        self._step += 1
        self.after(self.DURATION_MS // self.BAR_STEPS, self._tick)

    def _finish(self):
        self.destroy()
        self.master.deiconify()


                                                                               
                                              
                                                                               

def _panel_header(parent, title, subtitle, accent):
    """Renders the standard panel header bar."""
    hdr = _frame(parent, bg=C["bg2"])
    hdr.pack(fill="x", padx=0, pady=0)

                        
    stripe = tk.Frame(hdr, bg=accent, width=4)
    stripe.pack(side="left", fill="y")

    inner = _frame(hdr, bg=C["bg2"])
    inner.pack(side="left", fill="x", expand=True, padx=20, pady=16)

    tk.Label(inner, text=title, font=FM.title,
             fg=accent, bg=C["bg2"]).pack(anchor="w")
    tk.Label(inner, text=subtitle, font=FM.body,
             fg=C["muted"], bg=C["bg2"]).pack(anchor="w", pady=(2, 0))

    _sep(parent, bg=C["sep"]).pack(fill="x")


def _section_label(parent, text, accent, bg=None):
    tk.Label(parent, text=text, font=FM.subh,
             fg=accent, bg=bg or C["bg2"]).pack(anchor="w", padx=28, pady=(16, 4))


                                                                               
              
                                                                               

class CircuitPanel(_Frame):
    SCALABLE = [
        "Amplitude Estimation (AE)", "Deutsch-Jozsa", "Graph State",
        "GHZ State", "Grover's (no ancilla)", "Grover's (v-chain)",
        "Portfolio Optimization with QAOA", "Portfolio Optimization with VQE",
        "Quantum Approximation Optimization Algorithm (QAOA)",
        "Quantum Fourier Transformation (QFT)", "QFT Entangled",
        "Quantum Neural Network (QNN)",
        "Quantum Phase Estimation (QPE) exact",
        "Quantum Phase Estimation (QPE) inexact",
        "Quantum Walk (no ancilla)", "Quantum Walk (v-chain)",
        "Random Circuit", "Variational Quantum Eigensolver (VQE)",
        "Efficient SU2 ansatz with Random Parameters",
        "Real Amplitudes ansatz with Random Parameters",
        "Two Local ansatz with Random Parameters", "W-State",
    ]
    NON_SCALABLE = [
        "Ground State", "Pricing Call Option", "Pricing Put Option",
        "Routing", "Shor's", "Travelling Salesman",
    ]
    NATIVE_GATE_SETS = [
        ('IBM',         '["rz", "sx", "x", "cx"]'),
        ('Rigetti',     '["rx", "rz", "cz", "cp", "xx_plus_yy"]'),
        ('OQC',         '["rz", "sx", "x", "ecr"]'),
        ('IonQ',        '["rxx", "rz", "ry", "rx"]'),
        ('Quantinuum',  '["rzz", "rz", "ry", "rx"]'),
    ]

    def __init__(self, parent):
        super().__init__(parent)
        self._active_tab = tk.StringVar(value="Import")
        self._tab_frames: dict[str, tk.Frame] = {}
        self._build()

    def _build(self):
        _panel_header(self,
            "◈  Circuit",
            "Import a circuit, generate one via MQT Bench, or edit QASM directly.",
            C["accent"])

                 
        tab_bar = _frame(self, bg=C["bg3"])
        tab_bar.pack(fill="x")
        for name in ("Import", "MQT Bench", "QASM Editor"):
            btn = tk.Label(tab_bar, text=name, font=FM.menu,
                fg=C["muted"], bg=C["bg3"], padx=20, pady=10, cursor="hand2")
            btn.pack(side="left")
            btn.bind("<Button-1>", lambda e, n=name: self._switch_tab(n))
            setattr(self, f"_tab_btn_{name.replace(' ','_')}", btn)
        _sep(self, bg=C["sep"]).pack(fill="x")

        container = _frame(self)
        container.pack(fill="both", expand=True)
        for name, builder in [
            ("Import",      self._build_import),
            ("MQT Bench",   self._build_mqt),
            ("QASM Editor", self._build_editor),
        ]:
            f = _frame(container)
            f.place(relx=0, rely=0, relwidth=1, relheight=1)
            builder(f)
            self._tab_frames[name] = f

        self._switch_tab("Import")

    def _switch_tab(self, name: str):
        for n in ("Import", "MQT Bench", "QASM Editor"):
            btn = getattr(self, f"_tab_btn_{n.replace(' ','_')}")
            btn.config(
                fg=C["accent"] if n == name else C["muted"],
                bg=C["bg2"] if n == name else C["bg3"],
            )
        self._tab_frames[name].lift()
        self._active_tab.set(name)

                                                                               
    def _build_import(self, parent):
        _section_label(parent, "Import Circuit File", C["accent"])
        _label(parent, "Load an existing QASM or Python circuit file.",
               fg=C["muted"]).pack(anchor="w", padx=28, pady=(0, 12))

        row = _frame(parent)
        row.pack(fill="x", padx=28, pady=(0, 14))
        self._import_path = tk.StringVar(value="No file selected")
        _label(row, "File:", width=6, anchor="w").pack(side="left")
        _label(row, textvariable=self._import_path, fg=C["muted"],
               bg=C["bg3"], padx=10, pady=5, width=50, anchor="w",
               font=FM.mono).pack(side="left", padx=(0, 10))
        _ghost_button(parent=row, text="Browse…", accent=C["accent"],
                      command=self._browse_import, padx=12, pady=5).pack(side="left")

                    
        cards_row = _frame(parent)
        cards_row.pack(fill="x", padx=28, pady=(0, 18))
        self._stat_vars = {}
        for lbl in ("Qubits", "Gates", "Depth", "CX count"):
            c = _card(cards_row, padx=18, pady=12)
            c.pack(side="left", padx=(0, 10))
            v = tk.StringVar(value="—")
            self._stat_vars[lbl] = v
            tk.Label(c, textvariable=v, font=FM.title,
                     fg=C["accent"], bg=C["bg2"]).pack()
            tk.Label(c, text=lbl, font=FM.small,
                     fg=C["muted"], bg=C["bg2"]).pack()

        _sep(parent).pack(fill="x", padx=28, pady=(0, 12))
        _label(parent, "Preview:", font=FM.subh, fg=C["text"]).pack(anchor="w", padx=28, pady=(0, 4))
        self._import_preview = scrolledtext.ScrolledText(
            parent, font=FM.mono, bg=C["bg3"], fg=C["text"],
            insertbackground=C["accent"], relief="flat",
            height=16, padx=10, pady=8, state="disabled",
        )
        self._import_preview.pack(fill="both", expand=True, padx=28, pady=(0, 16))

    def _browse_import(self):
        path = filedialog.askopenfilename(
            filetypes=[("QASM files", "*.qasm"), ("Python files", "*.py"),
                       ("All files", "*.*")])
        if not path:
            return
        self._import_path.set(path)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                content = fh.read()
            self._import_preview.config(state="normal")
            self._import_preview.delete("1.0", "end")
            self._import_preview.insert("1.0", content)
            self._import_preview.config(state="disabled")
            self._editor_text.config(state="normal")
            self._editor_text.delete("1.0", "end")
            self._editor_text.insert("1.0", content)
        except Exception as exc:
            messagebox.showerror("Load error", str(exc))

                                                                               

                               font=FM.small, bg=C["bg2"], fg=C["text"],
                               selectcolor=C["bg3"], activebackground=C["bg2"]
                               ).pack(side="left", padx=(0, 12))
        elif val == "TKET" and show_opt:
            _label(self._compiler_sub_frame, "Placement setting:", font=FM.small, fg=C["text"]).pack(anchor="w", pady=(6, 2))
            self._tket_place = tk.StringVar(value="Graph Placement")
            place_row = _frame(self._compiler_sub_frame)
            place_row.pack(anchor="w")
            for p in ("Graph Placement", "Line Placement"):
                tk.Radiobutton(place_row, text=p, variable=self._tket_place, value=p,
                               font=FM.small, bg=C["bg2"], fg=C["text"],
                               selectcolor=C["bg3"], activebackground=C["bg2"]
                               ).pack(side="left", padx=(0, 16))

    def _toggle_all_scalable(self):
        val = self._sel_all_var.get()
        for v in self._scal_vars.values():
            v.set(val)

    def _generate_mqt(self):
        selected_s  = [n for n, v in self._scal_vars.items() if v.get()]
        selected_ns = [n for n, v in self._ns_vars.items() if v.get()]
        if not selected_s and not selected_ns:
            messagebox.showwarning("MQT Bench", "Please select at least one benchmark.")
            return
        self._mqt_log.config(state="normal")
        self._mqt_log.delete("1.0", "end")
        self._mqt_log.config(state="disabled")
        self._mqt_status.config(text="Generating…", fg=C["warning"])
        level = self._level_var.get()
        q_min = self._q_min.get()
        q_max = self._q_max.get()

        def _log(msg):
            self._mqt_log.after(0, lambda m=msg: (
                self._mqt_log.config(state="normal"),
                self._mqt_log.insert("end", m + "\n"),
                self._mqt_log.see("end"),
                self._mqt_log.config(state="disabled"),
            ))

        def _worker():
            try:
                from mqt.bench import get_benchmark                
            except ImportError:
                _log("[ERROR] mqt-bench is not installed.  Run:  pip install mqt.bench")
                self._mqt_status.after(0, lambda: self._mqt_status.config(
                    text="mqt-bench not found", fg=C["danger"]))
                return
            qasm_out = []
            for bench in selected_s + selected_ns:
                qubit_range = range(q_min, q_max+1) if bench in self.SCALABLE else [None]
                for nq in qubit_range:
                    try:
                        kwargs = {"level": level}
                        if nq is not None:
                            kwargs["num_qubits"] = nq
                        qc   = get_benchmark(bench, **kwargs)
                        qasm = qc.qasm() if hasattr(qc, "qasm") else str(qc)
                        qasm_out.append(f"// {bench}" + (f"  n={nq}" if nq else "") + "\n" + qasm)
                        _log(f"[OK]  {bench}" + (f"  n={nq}" if nq else ""))
                    except Exception as exc:
                        _log(f"[ERR] {bench}: {exc}")
            if qasm_out:
                combined = "\n\n".join(qasm_out)
                self._editor_text.after(0, lambda: (
                    self._editor_text.delete("1.0", "end"),
                    self._editor_text.insert("1.0", combined),
                ))
                self._mqt_status.after(0, lambda: self._mqt_status.config(
                    text=f"✓ {len(qasm_out)} circuit(s) generated → QASM Editor", fg=C["success"]))
            else:
                self._mqt_status.after(0, lambda: self._mqt_status.config(
                    text="No circuits generated.", fg=C["danger"]))

        threading.Thread(target=_worker, daemon=True).start()

                                                                               
    def _build_editor(self, parent):
        _section_label(parent, "QASM Editor", C["accent"])
        _label(parent, "Edit or inspect the circuit QASM. Changes here are used by downstream steps.",
               fg=C["muted"]).pack(anchor="w", padx=28, pady=(0, 10))
        tb = _frame(parent)
        tb.pack(fill="x", padx=28, pady=(0, 8))
        for txt, cmd in [("Save as…", self._save_qasm), ("Clear", self._clear_editor)]:
            _ghost_button(tb, txt, accent=C["accent"], command=cmd,
                          padx=10, pady=4).pack(side="left", padx=(0, 8))

        self._editor_text = scrolledtext.ScrolledText(
            parent, font=FM.mono, bg=C["bg3"], fg=C["text"],
            insertbackground=C["accent"], relief="flat", padx=10, pady=8,
        )
        self._editor_text.pack(fill="both", expand=True, padx=28, pady=(0, 16))
        self._editor_text.insert("1.0", "// QASM will appear here after import or generation\n")

    def _save_qasm(self):
        path = filedialog.asksaveasfilename(defaultextension=".qasm",
            filetypes=[("QASM files", "*.qasm"), ("All files", "*.*")])
        if path:
            try:
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(self._editor_text.get("1.0", "end"))
                messagebox.showinfo("Saved", f"QASM saved to:\n{path}")
            except Exception as exc:
                messagebox.showerror("Save error", str(exc))

    def _clear_editor(self):
        self._editor_text.delete("1.0", "end")


                                                                               
                                      
                                                                               

class NetworkModel:
    _id_counter = 0

    @classmethod
    def _new_id(cls, prefix: str) -> str:
        cls._id_counter += 1
        return f"{prefix}_{cls._id_counter:03d}"

    def __init__(self):
        self.nodes: dict[str, dict] = {}
        self.links: dict[str, dict] = {}
        self._listeners: list = []

    def subscribe(self, fn):
        self._listeners.append(fn)

    def _notify(self):
        for fn in self._listeners:
            fn()

    def add_node(self, kind: str, x: float = 100, y: float = 100) -> str:
        nid = self._new_id(kind.lower())
        defaults = {
            "QPU":    {"topology": "linear", "noise_model": "None",
                       "qubits": "5", "T1": "100 µs", "T2": "80 µs",
                       "gate_error": "0.001", "readout_error": "0.01",
                       "ibm_backend": "", "n_inputs": 2, "n_outputs": 2},
            "BS":     {"splitting_ratio": "0.5", "insertion_loss": "0.1 dB",
                       "bandwidth": "10 GHz", "phase_offset": "0",
                       "n_inputs": 2, "n_outputs": 2},
            "PBS":    {"extinction_ratio": "30 dB", "insertion_loss": "0.2 dB",
                       "bandwidth": "10 GHz", "n_inputs": 2, "n_outputs": 2},
            "Switch": {"num_bsm": "2", "bsm_efficiency": "0.9",
                       "bsm_dark_count": "100 Hz", "switching_time": "1 ns",
                       "n_inputs": 3, "n_outputs": 3},
            "BSM":    {"efficiency": "0.9", "dark_count": "100 Hz",
                       "n_inputs": 2, "n_outputs": 1},
        }.get(kind, {"n_inputs": 2, "n_outputs": 2})
        self.nodes[nid] = {"id": nid, "kind": kind, "x": x, "y": y,
                           "label": nid, **defaults}
        self._notify()
        return nid

    def add_link(self, src_id: str, dst_id: str) -> str:
        lid = self._new_id("link")
        self.links[lid] = {
            "id": lid, "src": src_id, "dst": dst_id,
            "src_port": "out1", "dst_port": "in1",
            "kind": "Fiber", "length": "10", "attenuation": "0.2",
            "channel": "Amplitude Damping",
            "gamma": "0.01", "phase": "0.0", "depol_p": "0.01",
            "n_index": "1.468", "dispersion": "17", "fidelity": "0.99",
        }
        self._notify()
        return lid

    def remove_node(self, nid: str):
        self.nodes.pop(nid, None)
        dead = [lid for lid, l in self.links.items()
                if l["src"] == nid or l["dst"] == nid]
        for lid in dead:
            self.links.pop(lid)
        self._notify()

    def remove_link(self, lid: str):
        self.links.pop(lid, None)
        self._notify()


                                                                               
             
                                                                               


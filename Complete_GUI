        self._run_btn = _button(btn_row, "▶  Run", accent=C["danger"],
                                command=self._run, padx=20, pady=8)
        self._run_btn.pack(side="left")
        _ghost_button(btn_row, "■  Stop", accent=C["danger"],
                      command=self._stop, padx=14, pady=8).pack(side="left", padx=10)

                      
        self._prog_var = tk.DoubleVar(value=0)
        style = ttk.Style()
        style.theme_use("clam")
        style.configure("Danger.Horizontal.TProgressbar",
                        troughcolor=C["bg3"], background=C["danger"],
                        bordercolor=C["bg3"],
                        lightcolor=C["danger"], darkcolor=C["danger"])
        self._prog = ttk.Progressbar(self, variable=self._prog_var,
                                     style="Danger.Horizontal.TProgressbar",
                                     maximum=100, mode="determinate")
        self._prog.pack(fill="x", padx=28, pady=(0, 16))

        _section_label(self, "Execution log", C["danger"])
        self._log = scrolledtext.ScrolledText(
            self, font=FM.mono, bg=C["bg3"], fg=C["text"],
            insertbackground=C["danger"], relief="flat",
            height=10, padx=10, pady=8, state="disabled",
        )
        self._log.pack(fill="both", expand=True, padx=28, pady=(0, 20))

    def _log_write(self, msg):
        self._log.config(state="normal")
        self._log.insert("end", msg + "\n")
        self._log.see("end")
        self._log.config(state="disabled")

    def _run(self):
        if self._running: return
        self._running = True
        self._prog_var.set(0)
        self._log.config(state="normal")
        self._log.delete("1.0", "end")
        self._log.config(state="disabled")
        msgs = [
            (10,  "[INFO]  Connecting to backend…"),
            (25,  "[INFO]  Transpiling for backend gate set…"),
            (40,  "[INFO]  Submitting job…"),
            (60,  "[INFO]  Running shot 1 / 1024…"),
            (80,  "[INFO]  Collecting results…"),
            (95,  "[INFO]  Post-processing measurement outcomes…"),
            (100, "[OK]    Job complete. Results ready."),
        ]
        def _worker():
            for pct, msg in msgs:
                if not self._running: break
                time.sleep(0.5)
                self._prog_var.set(pct)
                self.after(0, lambda m=msg: self._log_write(m))
            self._running = False
        threading.Thread(target=_worker, daemon=True).start()

    def _stop(self):
        self._running = False
        self._log_write("[WARN]  Execution stopped by user.")


                                                                               
             
                                                                               

class MainWindow(tk.Tk):
    MENU_ITEMS = [
        ("Circuit",  "◈", CircuitPanel,  C["accent"]),
        ("Network",  "⬡", NetworkPanel,  C["accent2"]),
        ("Compile",  "⚙", CompilePanel,  C["success"]),
        ("Schedule", "▦", SchedulePanel, C["warning"]),
        ("Run",      "▶", RunPanel,      C["danger"]),
    ]

    def __init__(self):
        super().__init__()
        self.withdraw()
        self.title("QNEST — Quantum Network End-to-end Simulation Toolkit")
        self.configure(bg=C["bg"])

        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        w, h   = int(sw * 0.82), int(sh * 0.82)
        self.geometry(f"{w}x{h}+{(sw-w)//2}+{(sh-h)//2}")
        self.minsize(900, 600)

        self._panels:    dict[str, tk.Frame]  = {}
        self._menu_btns: dict[str, tk.Label]  = {}
        self._menu_accents: dict[str, str]    = {}
        self._active: str = ""

        self._build_layout()
        self._select("Circuit")
                                                                 
        FM._init()
        FM.scale(w, h)
        self._last_size = (w, h)
        self.bind("<Configure>", self._on_resize)
        SplashScreen(self)

    def _build_layout(self):
                                                                                
        topbar = tk.Frame(self, bg=C["bg2"], height=50,
                          highlightbackground=C["border"], highlightthickness=1)
        topbar.pack(fill="x", side="top")
        topbar.pack_propagate(False)

                   
        tk.Label(topbar, text="◈ QNEST",
                 font=FM.head,
                 fg=C["accent"], bg=C["bg2"], padx=20).pack(side="left", fill="y")
        tk.Frame(topbar, bg=C["border"], width=1).pack(side="left", fill="y", pady=10)
        tk.Label(topbar, text="Quantum Network End-to-end Simulation Toolkit",
                 font=FM.body,
                 fg=C["muted"], bg=C["bg2"], padx=14).pack(side="left", fill="y")

                                                                                
        body = tk.Frame(self, bg=C["bg"])
        body.pack(fill="both", expand=True)

                                                                                
        sidebar = tk.Frame(body, bg=C["bg2"],
                           highlightbackground=C["border"], highlightthickness=1)
        sidebar.pack(side="left", fill="y")
        sidebar.pack_propagate(False)
        self.update_idletasks()
        sidebar.config(width=max(140, self.winfo_width() // 7))
        self.bind("<Configure>", lambda e: sidebar.config(
            width=max(140, self.winfo_width() // 7)))

        tk.Label(sidebar, text="MENU", font=FM.small,
                 fg=C["hint"], bg=C["bg2"], padx=16, pady=14).pack(anchor="w")
        _sep(sidebar).pack(fill="x")

        for name, icon, _, accent in self.MENU_ITEMS:
            self._menu_accents[name] = accent
            btn = tk.Label(sidebar,
                text=f"  {icon}  {name}",
                font=FM.menu, fg=C["muted"], bg=C["bg2"],
                anchor="w", padx=8, pady=14, cursor="hand2")
            btn.pack(fill="x")
            btn.bind("<Button-1>", lambda e, n=name: self._select(n))
            btn.bind("<Enter>",    lambda e, b=btn, n=name: self._hover(b, n, True))
            btn.bind("<Leave>",    lambda e, b=btn, n=name: self._hover(b, n, False))
            self._menu_btns[name] = btn

        tk.Label(sidebar, text="v0.1.0", font=FM.small,
                 fg=C["hint"], bg=C["bg2"], pady=10).pack(side="bottom")

                                                                                
        self._content = tk.Frame(body, bg=C["bg2"])
        self._content.pack(side="left", fill="both", expand=True)

        for name, _, PanelClass, _ in self.MENU_ITEMS:
            panel = PanelClass(self._content)
            panel.place(relx=0, rely=0, relwidth=1, relheight=1)
            self._panels[name] = panel

    def _on_resize(self, event):
                                                                         
        if event.widget is not self:
            return
        w, h = event.width, event.height
        if (w, h) == getattr(self, "_last_size", None):
            return
        self._last_size = (w, h)
        FM.scale(w, h)

    def _select(self, name: str):
        if self._active:
            prev = self._menu_btns[self._active]
            prev.config(fg=C["muted"], bg=C["bg2"])
        self._active = name
        accent = self._menu_accents[name]
        btn    = self._menu_btns[name]
        btn.config(fg=accent, bg=C["menu_sel"])
        self._panels[name].lift()

    def _hover(self, btn: tk.Label, name: str, entering: bool):
        if name == self._active: return
        btn.config(bg=C["menu_hover"] if entering else C["bg2"])


                                                                               
             
                                                                               


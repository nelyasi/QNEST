            else:
                e = _entry(row, width=10, accent=C["success"])
                e.insert(0, default)
                e.pack(side="left", padx=4)

        _button(self, "▶  Compile", accent=C["success"],
                command=self._compile, padx=20, pady=8).pack(anchor="w", padx=28, pady=(0, 16))

        _section_label(self, "Compiler log", C["success"])
        self._log = scrolledtext.ScrolledText(
            self, font=FM.mono, bg=C["bg3"], fg=C["text"],
            insertbackground=C["success"], relief="flat",
            height=12, padx=10, pady=8, state="disabled",
        )
        self._log.pack(fill="both", expand=True, padx=28, pady=(0, 20))

    def _compile(self):
        self._log.config(state="normal")
        self._log.delete("1.0", "end")
        self._log.config(state="disabled")
        msgs = [
            "[INFO]  Reading circuit…",
            "[INFO]  Running MinCut partitioner…",
            "[INFO]  Partition: server_0 ← {q0,q1,q2}  server_1 ← {q3,q4}",
            "[INFO]  Inserting ebit pairs at gate indices: 4, 11, 17",
            "[INFO]  Optimisation pass 1 complete — depth reduced by 12 %",
            "[INFO]  Generating distributed circuit…",
            "[OK]    Compilation successful. 3 communication gates inserted.",
        ]
        def _stream():
            for m in msgs:
                time.sleep(0.35)
                self._log.after(0, lambda msg=m: (
                    self._log.config(state="normal"),
                    self._log.insert("end", msg + "\n"),
                    self._log.see("end"),
                    self._log.config(state="disabled"),
                ))
        threading.Thread(target=_stream, daemon=True).start()


                                                                               
               
                                                                               


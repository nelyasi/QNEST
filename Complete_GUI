    def _refresh_level_opts(self):
        for w in self._level_opts_frame.winfo_children():
            w.destroy()
        level = self._level_var.get()
        if level == "target_independent":
            self._build_compiler_choice(self._level_opts_frame, "_ti_compiler")
        elif level == "target_dependent_native":
            _label(self._level_opts_frame, "Select targeted native gate-set:",
                   font=FM.small, fg=C["text"]).pack(anchor="w", pady=(0, 4))
            self._native_gs = tk.StringVar(value="IBM")
            for short, gates in self.NATIVE_GATE_SETS:
                tk.Radiobutton(self._level_opts_frame, text=f"{short}   {gates}",
                               variable=self._native_gs, value=short,
                               font=FM.small_mono, bg=C["bg2"], fg=C["text"],
                               selectcolor=C["bg3"], activebackground=C["bg2"],
                               ).pack(anchor="w", padx=8, pady=1)
            _sep(self._level_opts_frame).pack(fill="x", pady=(6, 6))
            self._build_compiler_choice(self._level_opts_frame, "_tdn_compiler")
        elif level == "target_dependent_mapped":
            self._build_compiler_choice(self._level_opts_frame, "_tdm_compiler", show_opt=True)

    def _build_compiler_choice(self, parent, attr: str, show_opt: bool = False):
        _label(parent, "Select the used compiler:", font=FM.small, fg=C["text"]).pack(anchor="w", pady=(0, 4))
        var = tk.StringVar(value="Qiskit")
        setattr(self, attr, var)
        row = _frame(parent)
        row.pack(anchor="w")
        for compiler in ("Qiskit", "TKET"):
            tk.Radiobutton(row, text=compiler, variable=var, value=compiler,
                           font=FM.small, bg=C["bg2"], fg=C["text"],
                           selectcolor=C["bg3"], activebackground=C["bg2"],
                           command=lambda: self._refresh_compiler_sub(parent, attr, show_opt)
                           ).pack(side="left", padx=(0, 16))
        self._compiler_sub_frame = _frame(parent)
        self._compiler_sub_frame.pack(anchor="w", padx=8)
        self._refresh_compiler_sub(parent, attr, show_opt)

    def _refresh_compiler_sub(self, parent, attr: str, show_opt: bool):
        for w in self._compiler_sub_frame.winfo_children():
            w.destroy()
        compiler = getattr(self, attr, None)
        if compiler is None:
            return
        val = compiler.get()
        if val == "Qiskit" and show_opt:
            _label(self._compiler_sub_frame, "Optimization level:", font=FM.small, fg=C["text"]).pack(anchor="w", pady=(6, 2))
            self._qiskit_opt = tk.IntVar(value=1)
            opt_row = _frame(self._compiler_sub_frame)
